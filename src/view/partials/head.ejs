<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="Hope It Pans Out Catering (HIPOC) is a premier catering service that offers
    a wide range of delicious and customizable menu options for all occasions. 
    Whether you're planning a corporate event, wedding, or private party, 
    HIPOC has you covered with exceptional service and delectable cuisine.">
    <meta name="keywords" content="HIPOC, catering service, event catering, 
    wedding catering, corporate catering, private party catering, customizable menu, delicious cuisine">
    <meta name="author" content="HIPOC">
    <link rel="stylesheet" href="./css/base.css">
    <script type="module" src="./js/main.js" defer></script>
    <%- renderStyles() %>
    <%- renderScripts() %>
    <% if (NODE_ENV.includes('dev')) { %>
        <script>
            // Get the current hostname and port from the browser
            const host = window.location.hostname;
            const currentPort = window.location.port;
            // Calculate WebSocket port (current port + 1)
            const wsPort = currentPort ? (parseInt(currentPort) + 1) : 3001;
            // Create WebSocket connection using dynamic hostname and port
            const ws = new WebSocket(`ws://${host}:${wsPort}`);
            ws.onclose = () => {
                setTimeout(() => location.reload(), 2000);
            };
        </script>
    <% } %>
</head>