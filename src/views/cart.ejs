<%- include('partials/head') %>
<%- include('partials/header') %>

    <main class="cart-page">

    <h1>Your Cart</h1>

    <div class="cart-page-layout">

        <!-- CART ITEMS -->
        <section class="cart-page-items">
            <h2>Your Order</h2>
            <div id="cart-page-items">
                <!-- JS inserts cart items -->
            </div>
        </section>

        <!-- SUMMARY -->
        <aside class="cart-page-summary">
            <h2>Order Summary</h2>
            <div class="summary-row">
                <span>Subtotal</span>
                <span>
                    $<span id="page-subtotal">0.00</span>
                </span>
            </div>
            <div class="summary-row">
                <span>Number of Guests</span>
                <span id="cart-guest-count">0</span>
            </div>

            <div class="summary-row">
                <span>Tax</span>
                <span>
                    $<span id="page-tax">0.00</span>
                </span>
            </div>
            
            <div class="summary-row total">
                <span>Total</span>
                <span>
                    $<span id="page-total">0.00</span>
                </span>
            </div>
            <button id="page-checkout-btn">
                Proceed to Checkout
            </button>
        </aside>
    </div>
</main>

<%- include("partials/footer") %>