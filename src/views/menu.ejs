<%- include('partials/head') %>
<%- include('partials/header') %>

    <main class="menu-page">

        <!-- MAIN LAYOUT -->
        <div class="menu-layout">

            <!-- LEFT: CART SIDEBAR -->
            <aside class="cart-sidebar">

                <div class="cart-header">
                    <h2>Your Order</h2>
                </div>

                <!-- SCROLLABLE ITEM AREA -->
                <div class="cart-items" id="cart-sidebar-items"></div>

                <!-- SUMMARY (always visible above button) -->
                <div class="cart-summary">

                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span>$<span id="cart-subtotal">0.00</span></span>
                    </div>

                    <div class="summary-row">
                        <span>Tax</span>
                        <span>$<span id="cart-tax">0.00</span></span>
                    </div>

                    <div class="summary-row total">
                        <span>Total</span>
                        <span>$<span id="cart-total">0.00</span></span>
                    </div>

                </div>

                <!-- STICKY ACTION BUTTON -->
                <div class="cart-actions">
                    <button id="checkout-btn">Proceed to Checkout</button>
                </div>

            </aside>

            <!-- RIGHT: MENU CONTENT -->
            <section class="menu-items">

                <h1>Our Menu</h1>

                <p>
                    Explore our wide range of delicious and customizable menu options for all occasions.
                    Whether you're planning a corporate event, wedding, or private party,
                    HIPOC has you covered with exceptional service and delectable cuisine.
                </p>

                <p>Click items to add them to your order.</p>

                <!-- MENU GRID (JS INJECTS ITEMS HERE) -->
                <section class="guest-calculator">

                    <h2>Plan Your Event</h2>

                    <label for="guest-count">
                        Number of Guests:
                    </label>

                    <input  
                        type="number" 
                        id="guest-count"
                        min="1"
                        max="2000"
                        step="1"
                        value=""
                        placeholder="Enter guests"
                        inputmode="numeric">

                    <p>
                        Enter your guest count to see how much food you need.
                    </p>

                </section>
                <div id="menu-list">
                    <% if (menuByCategory && Object.keys(menuByCategory).length > 0) { %>
                        <% Object.entries(menuByCategory).forEach(([category, items]) => { %>
                            <section class="menu-category" data-category="<%= category %>">
                                <h2><%= category %></h2>

                                <div class="menu-grid">
                                    <% items.forEach((item) => { %>
                                        <article
                                            class="menu-card"
                                            data-menu-item-id="<%= item.menu_item_id %>"
                                            data-name="<%= item.name %>"
                                            data-category="<%= item.category %>"
                                            data-servings-per-tray="<%= item.servings_per_tray %>"
                                            data-price-per-serving="<%= item.price_per_serving %>"
                                            data-tray-price="<%= item.tray_price %>"
                                        >
                                            <img
                                                src="<%= item.image %>"
                                                alt="<%= item.name %>"
                                                loading="lazy"
                                            >

                                            <div class="menu-card-body">
                                                <h3><%= item.name %></h3>
                                                <p class="menu-description"><%= item.description %></p>

                                                <div class="menu-meta">
                                                    <span>Serves <strong><%= item.servings_per_tray %></strong> per tray</span>
                                                    <span>$<%= Number(item.price_per_serving).toFixed(2) %> / serving</span>
                                                    <span><strong>$<%= Number(item.tray_price).toFixed(2) %></strong> / tray</span>
                                                </div>

                                                <p class="recommended-trays" data-recommended-for="<%= item.menu_item_id %>"></p>

                                                <button
                                                    type="button"
                                                    class="add-to-order-btn"
                                                    data-menu-item-id="<%= item.menu_item_id %>"
                                                >
                                                    Add to Order
                                                </button>
                                            </div>
                                        </article>
                                    <% }) %>
                                </div>
                            </section>
                        <% }) %>
                    <% } else { %>
                        <p>No menu items are available right now.</p>
                    <% } %>
                </div>
            </section>
        </div>

        <!-- MOBILE CART BAR -->
<div class="mobile-cart-bar">

    <button id="open-cart">

        🛒 View Order
        (<span id="mobile-count">0</span>)

    </button>

</div>



<!-- MOBILE CART DRAWER -->
<div class="mobile-cart-drawer">

    <div class="drawer-header">
        <h3>Your Order</h3>
        <button id="close-cart">
            ✕ Close
        </button>
    </div>

    <div id="mobile-cart-items"></div>

    <div class="drawer-summary">

    <p>
        Subtotal:
        $<span id="mobile-subtotal">0.00</span>
    </p>

    <p>
        Tax:
        $<span id="mobile-tax">0.00</span>
    </p>

    <p class="mobile-total">
        Total:
        $<span id="mobile-total">0.00</span>
    </p>

    <button id="mobile-checkout">
        Proceed to Checkout
    </button>

</div>

</div>

    </main>

<%- include("partials/footer") %>